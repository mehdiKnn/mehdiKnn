    SetTextColor 200 255 100 255
    SetBorderColor 150 200 50 255
    MinimapIcon 1 Green Kite
    PlayEffect Green


#===============================================================================
# 7) RARES UTILES  (craft / vente / chaos-regal fodder)
#===============================================================================

# --- Rares armure Evasion haut ilvl (bases a crafter pour la build) -----------
Show
    Rarity Rare
    Class "Helmet" "Gloves" "Boots" "Body Armour"
    ItemLevel >= 75
    SetFontSize 38
    SetTextColor 255 255 119 255
    SetBorderColor 200 200 80 255
    MinimapIcon 1 Yellow Circle

# --- Rares bijouterie (anneaux/amulette/ceinture) — toujours utiles ----------
Show
    Rarity Rare
    Class "Ring" "Amulet" "Belt"
    SetFontSize 38
    SetTextColor 255 255 119 255
    SetBorderColor 220 220 90 255
    MinimapIcon 1 Yellow Circle
    PlayEffect Yellow

# --- Autres rares haut ilvl (fodder de craft / disenchant) --------------------
Show
    Rarity Rare
    ItemLevel >= 65
    SetFontSize 34
    SetTextColor 255 255 119 255
    SetBorderColor 90 90 90 255


#===============================================================================
# 8) QUALITE  (objets a quality, utiles pour recettes / craft)
#===============================================================================
Show
    Quality >= 18
    SetFontSize 36
    SetTextColor 200 200 255 255
    SetBorderColor 120 120 200 255


#===============================================================================
# 9) NETTOYAGE  (semi-stricte : on cache le bruit restant)
#===============================================================================

# --- On cache les rares bas ilvl non couverts ---------------------------------
Hide
    Rarity Rare

# --- On cache tout le reste (normaux / magiques non pertinents) ---------------
Hide
    Rarity <= Magic
